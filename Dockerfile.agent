# Build stage
FROM golang:1.26-bookworm AS builder

WORKDIR /workspace

# Copy dependency manifests and download modules
COPY go.mod go.sum ./
RUN go mod download

# Copy entire source tree
COPY . .

# Build the node-agent binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -o node-agent cmd/node-agent/main.go

# Runtime stage
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    openvswitch-switch \
    iproute2 \
    ethtool \
    iptables \
    libvirt-clients \
    qemu-utils \
    genisoimage \
    procps \
    pciutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /

COPY --from=builder /workspace/node-agent .

ENTRYPOINT ["/node-agent"]
